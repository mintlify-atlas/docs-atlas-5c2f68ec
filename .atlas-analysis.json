  "keyFeatures": [
    "Sandboxed Python execution with strict security guarantees",
    "Multi-language bindings (Python, JavaScript/TypeScript, Rust)",
    "Microsecond startup time and snapshotting support",
    "Type checking with integrated ty/ruff support",
    "Resource limits (memory, allocations, execution time)",
    "External function callbacks for controlled I/O",
    "Iterative execution with pause/resume at function calls",
    "Serialization of parsed code and execution state"
  ],
